# ============================================================
# VALEUM — Variables de entorno (todas server-side)
# Ninguna lleva prefijo VITE_: no deben llegar al navegador.
# En producción se configuran en Vercel → Settings → Environment Variables.
# ============================================================

# --- Supabase (proyecto designflow-ai, schema valeum_web) ---
SUPABASE_URL="https://qmezdqqzhoeuyeymavdv.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_aqui"

# --- SMTP (Google Workspace) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="no-reply@tudominio.com"
SMTP_PASS="app_password_de_16_caracteres"
MAIL_FROM="Valeum <no-reply@tudominio.com>"

# --- Destinatarios y calendarios ---
JESUS_EMAIL="jesus@tudominio.com"
HARRY_EMAIL="harry@tudominio.com"
JESUS_CAL_URL="https://calendar.app.google/XXXXXXXX"
HARRY_CAL_URL="https://calendar.app.google/YYYYYYYY"

# --- Google Calendar API (cuenta de servicio con delegación de dominio) ---
# La cuenta de servicio ya existe: ver docs/google-calendar-setup.md
JESUS_CALENDAR_ID="jesus@tudominio.com"
HARRY_CALENDAR_ID="harry@tudominio.com"
GOOGLE_SA_EMAIL="valeum-calendar@valeum-bb990.iam.gserviceaccount.com"
# Clave privada del JSON de la cuenta de servicio, con los \n literales tal cual
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Protege /api/calendar/sync frente a llamadas externas ---
SYNC_SECRET="cadena_larga_y_aleatoria"
